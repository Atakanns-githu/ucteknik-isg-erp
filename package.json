{
  "name": "ucteknik-isg-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Üçteknik Mühendislik İSG Periyodik Kontrol ve Raporlama Yönetim Sistemi",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/verify-build-artifact.mjs",
    "vercel-build": "node scripts/unpack-repo.mjs && prisma generate && next build",
    "postinstall": "node scripts/unpack-repo.mjs && prisma generate",
    "start": "next start",
    "prod": "pnpm build && pnpm start",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js src prisma scripts next.config.ts tailwind.config.ts vitest.config.mts",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "audit:reports": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/audit-published-reports.ts",
    "audit:storage": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/audit-storage.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/worker.ts",
    "prisma:deploy": "prisma migrate deploy",
    "preflight:prod": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/preflight-prod.ts",
    "drill:restore": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/restore-drill.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^7.10.1",
    "asn1js": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "10.6.0",
    "docx": "^9.2.1",
    "exceljs": "^4.4.0",
    "googleapis": "^190.0.0",
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pkijs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smtp-mailer": "npm:nodemailer@10.6.0",
    "tailwind-merge": "^3.0.2",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/smtp-mailer": "npm:@types/nodemailer@8.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
